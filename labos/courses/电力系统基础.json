  "objectives": [
    {
      "id": 1,
      "desc": "掌握电力系统分析基本原理",
      "grad_req": "1-3",
      "detail": "能够将电力系统专业知识和数学模型方法用于电力系统的规划、设计、运行和控制问题。"
    },
    {
      "id": 2,
      "desc": "具备电力系统运行分析能力",
      "grad_req": "2-2",
      "detail": "能够基于电力系统基本原理，选择合适的计算或仿真工具对电力系统复杂工程问题进行有效分解、建模和分析。"
    },
    {
      "id": 3,
      "desc": "具备电力系统工程问题研究能力",
      "grad_req": "4-4",
      "detail": "能够针对电力系统复杂工程问题进行研究，对研究结果进行分析与解释，获取合理有效的结论。"
    },
    {
      "id": 4,
      "desc": "具备区域电网或变电站一次系统规划设计的能力",
      "grad_req": "11-3",
      "detail": "熟悉电力系统设计流程，掌握电力工程计算方法，理解电气设备选型的原则并能灵活运用。"
    }
  ],
